obj-m := urp.o
urp-y := urp_main.o urp_socket.o urp_rdma.o urp_pump.o urp_proc.o \
	    urp_endpoint.o urp_netlink.o urp_qp.o urp_srq.o urp_credit.o \
	    urp_stream.o urp_stream_sm.o urp_frame.o urp_cmd.o urp_cmd_validate.o \
	    urp_sysctl.o

# Phase 3a Step 5b: reorder backend selection. Default is the C
# rbtree implementation; CONFIG_URP_REORDER_RUST=y swaps in the Rust
# FFI shim. The Rust staticlib is pre-extracted by the Nix derivation
# (or local build script) into kernel/rust_ffi/*.o so kbuild can list
# the objects in urp-y alongside the shim. ld -r doesn't pull
# unreferenced objects out of static archives, hence the extraction.
ifeq ($(CONFIG_URP_REORDER_RUST),y)
urp-y += urp_reorder_rust.o $(patsubst $(src)/%.o,%.o,$(wildcard $(src)/rust_ffi/*.o))
ccflags-y += -DCONFIG_URP_REORDER_RUST=1
# objtool can't validate the Rust compiler-builtins' x86 FMA helpers
# (compiler_builtins::math::libm_math::arch::x86::fma::fma_with_fma4
# and friends). On CONFIG_X86_KERNEL_IBT=y kernels objtool is wired
# into the multi-obj-m link via $(delay-objtool) -- OBJECT_FILES_NON_STANDARD
# only disables the per-source pass, not the module-link pass.
# Override the per-target make variable so the link step skips it; the
# default C-only build (`nix build .#urp-ko`) keeps full objtool
# coverage.
urp.o: private objtool-enabled :=
else
urp-y += urp_reorder.o
endif

urp-$(CONFIG_KUNIT) += urp_test.o

# urp-fast zero-copy data path (design 31). CONFIG_URP_FAST defaults to y and
# selects the /dev/urp uring_cmd device + fast handlers in urp_cmd.c. Build with
# CONFIG_URP_FAST=n to exclude the whole zero-copy path (cert / attack-surface):
# urp_cmd.c then compiles to stubs (URP_FAST_ENABLED == 0, see urp.h) and the
# control plane rejects `--kind fast` with -EOPNOTSUPP. The copy (uds) path never
# depends on this. There is no in-tree Kconfig here (out-of-tree module), so the
# symbol is a make/ccflags variable, mirroring CONFIG_URP_REORDER_RUST above.
# urp_cmd.o / urp_cmd_validate.o stay in the build either way: the pure
# validators feed KUnit + the userspace check regardless, and the device body is
# gated internally by the preprocessor so kbuild's object list is stable.
CONFIG_URP_FAST ?= y
ifeq ($(CONFIG_URP_FAST),y)
ccflags-y += -DCONFIG_URP_FAST=1
endif

ccflags-y += -I$(src)/include
